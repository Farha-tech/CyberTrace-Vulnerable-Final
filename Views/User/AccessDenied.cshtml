<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />

    <title>Access Denied</title>

    <style>
            body {
                font-family: Arial, sans-serif;
                background: #0f172a;
                color: white;
                padding: 40px;
            }

            .container {
                max-width: 700px;
                margin: auto;
                text-align: center;
            }

            .box {
                background: #1e293b;
                padding: 40px;
                border-radius: 12px;
                margin-top: 50px;
            }

            h1 {
                color: #ef4444;
            }

            p {
                color: #cbd5e1;
                font-size: 18px;
            }
    </style>
</head>

<body>

    <div class="container">

        <div class="box">

            <h1>Access Denied</h1>

            <p>
                You are not authorized to access this user's profile.
            </p>

            <p>
                IDOR protection is working correctly.
            </p>

        </div>

    </div>

</body>
</html>