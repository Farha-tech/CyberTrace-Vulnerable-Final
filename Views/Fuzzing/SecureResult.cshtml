@{
    ViewData["Title"] = "Fuzzing Secure Result";
}

<div class="container mt-5">

    <div class="card border-success shadow">

        <div class="card-header bg-success text-white">

            <h2>
                🟢 Fuzzing - Secure Result
            </h2>

        </div>

        <div class="card-body">

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger">

                    <h5>
                        Input Blocked
                    </h5>

                    <p class="mb-0">
                        @ViewBag.Error
                    </p>

                </div>

                <div class="alert alert-success">

                    <strong>
                        Security Protection:
                    </strong>

                    <p class="mb-0 mt-2">

                        The secure implementation validates the
                        supplied input before accepting it.

                        This prevents unexpected or oversized input
                        from being processed by the application.

                    </p>

                </div>
            }
            else
            {
                <div class="alert alert-success">

                    <h5>
                        Input Accepted
                    </h5>

                    <p class="mb-0">
                        @ViewBag.Success
                    </p>

                </div>

                <div class="mb-3">

                    <strong>Validated Input:</strong>

                    <pre class="bg-dark text-light p-3 rounded mt-2"
                         style="white-space: pre-wrap;">@ViewBag.Input</pre>

                </div>

                <div class="mb-3">

                    <strong>Input Length:</strong>

                    <span class="badge bg-secondary">
                        @ViewBag.Length
                    </span>

                </div>

                <div class="alert alert-info">

                    <strong>
                        Why was this accepted?
                    </strong>

                    <p class="mb-0 mt-2">

                        The input passed the application's validation
                        rules and its length is within the allowed limit.

                    </p>

                </div>
            }

            <a asp-controller="Fuzzing"
               asp-action="Index"
               class="btn btn-secondary">

                Back to Fuzzing Lab

            </a>

        </div>

    </div>

</div>