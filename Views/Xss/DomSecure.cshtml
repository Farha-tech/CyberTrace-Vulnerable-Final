@{
    ViewData["Title"] = "Secure DOM XSS";
}

<div class="container mt-5">

    <div class="text-center mb-5">

        <span class="badge">
            SECURE XSS LAB
        </span>

        <h1 class="mt-3">
            DOM-Based XSS - Secure Version
        </h1>

        <p>
            User-controlled data is safely inserted as text.
        </p>

    </div>

    <div class="card p-4 mx-auto" style="max-width: 800px;">

        <h3>Secure DOM XSS</h3>

        <p>
            The application uses textContent instead of innerHTML.
        </p>

        <div id="output" class="alert alert-success">
        </div>

    </div>

</div>

<script>
    const params = new URLSearchParams(window.location.search);

    const message = params.get("message");

    document.getElementById("output").textContent =
        message || "No message provided.";
</script>