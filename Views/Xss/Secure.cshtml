@{
    ViewData["Title"] = "Secure XSS Lab";
}

<div class="container mt-5">

    <div class="text-center mb-5">

        <span class="badge">
            SECURE XSS LAB
        </span>

        <h1 class="mt-3">
            Reflected XSS - Secure Version
        </h1>

        <p>
            The application safely displays user input using HTML encoding.
        </p>

    </div>

    <div class="card p-4 mx-auto" style="max-width: 700px;">

        <h3>Secure XSS Test</h3>

        <p>
            Enter a value and submit it to test the secure endpoint.
        </p>

        <form method="get" asp-controller="Xss" asp-action="Secure">

            <div class="mb-3">

                <label for="input" class="form-label">
                    Your Input
                </label>

                <input type="text"
                       id="input"
                       name="input"
                       class="form-control"
                       placeholder="Enter your input..." />

            </div>

            <button type="submit" class="scan-button">
                Test Secure Version
            </button>

        </form>

        @if (ViewBag.Input != null)
        {
            <div class="mt-4">

                <h4>Server Response</h4>

                <div class="alert alert-success">

                    @ViewBag.Input

                </div>

            </div>
        }

    </div>

</div>