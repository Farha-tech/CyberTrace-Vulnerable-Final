@model List<CyberTrace.Models.GuestMessage>

@{
    ViewData["Title"] = "Secure Stored XSS";
}

<div class="container mt-5">

    <div class="text-center mb-5">

        <span class="badge">
            SECURE XSS LAB
        </span>

        <h1 class="mt-3">
            Stored XSS - Secure Version
        </h1>

        <p>
            Stored messages are safely encoded before being displayed.
        </p>

    </div>

    <div class="card p-4 mx-auto" style="max-width: 800px;">

        <h3>Add Guest Message</h3>

        <form method="post"
              asp-controller="Xss"
              asp-action="StoredSecure">

            <div class="mb-3">

                <label class="form-label">
                    Username
                </label>

                <input type="text"
                       name="username"
                       class="form-control"
                       placeholder="Enter username"
                       required />

            </div>

            <div class="mb-3">

                <label class="form-label">
                    Message
                </label>

                <textarea name="message"
                          class="form-control"
                          rows="4"
                          placeholder="Enter your message..."
                          required></textarea>

            </div>

            <button type="submit" class="scan-button">
                Save Secure Message
            </button>

        </form>

    </div>

    <div class="mt-5">

        <h3>
            Stored Messages
        </h3>

        @foreach (var message in Model)
        {
            <div class="card p-4 mt-3">

                <h5>
                    @message.Username
                </h5>

                <p>
                    @message.Message
                </p>

                <small>
                    @message.CreatedAt
                </small>

            </div>
        }

    </div>

</div>