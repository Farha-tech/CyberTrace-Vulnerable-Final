@{
    ViewData["Title"] = "XSS Lab";
}

<div class="container mt-5">

    <div class="text-center mb-5">

        <span class="badge">
            XSS SECURITY LAB
        </span>

        <h1 class="mt-3">
            Reflected XSS
        </h1>

        <p>
            Test how unsanitized user input can be reflected into a web page.
        </p>

    </div>

    <div class="card p-4 mx-auto" style="max-width: 700px;">

        <h3>Vulnerable XSS Test</h3>

        <p>
            Enter a value and submit it to test the vulnerable endpoint.
        </p>

        <form method="get" asp-controller="Xss" asp-action="Index">

            <div class="mb-3">

                <label for="input" class="form-label">
                    Your Input
                </label>

                <input type="text"
                       id="input"
                       name="input"
                       class="form-control"
                       placeholder="Enter your input..." />

            </div>

            <button type="submit" class="scan-button">
                Test Vulnerable Version
            </button>

        </form>

        @if (ViewBag.Input != null)
        {
            <div class="mt-4">

                <h4>Server Response</h4>

                <div class="alert alert-warning">

                    @Html.Raw(ViewBag.Input)

                </div>

            </div>
        }

    </div>

</div>