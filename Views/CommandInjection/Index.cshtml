@{
    ViewData["Title"] = "OS Command Injection Lab";
}

<div class="container mt-5">

    <div class="text-center mb-5">

        <h1>OS Command Injection</h1>

        <p class="text-muted">
            CyberTrace Command Injection Security Lab
        </p>

    </div>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger shadow mb-4">

            <h5>
                Request Blocked
            </h5>

            <p class="mb-0">
                @ViewBag.Error
            </p>

        </div>
    }

    <div class="row">

        <!-- Vulnerable Version -->

        <div class="col-md-6 mb-4">

            <div class="card border-danger shadow">

                <div class="card-header bg-danger text-white">

                    <h4 class="mb-0">
                        🔴 Vulnerable Version
                    </h4>

                </div>

                <div class="card-body">

                    <p>
                        The vulnerable version directly passes
                        user input to the operating system command shell.
                    </p>

                    <form asp-controller="CommandInjection"
                          asp-action="Vulnerable"
                          method="post">

                        <div class="mb-3">

                            <label class="form-label">
                                Command
                            </label>

                            <input type="text"
                                   name="command"
                                   class="form-control"
                                   placeholder="whoami"
                                   required />

                        </div>

                        <button type="submit"
                                class="btn btn-danger">

                            Execute Command

                        </button>

                    </form>

                    <hr />

                    <p class="small text-muted">
                        Lab command examples:
                    </p>

                    <code>whoami</code>
                    <br />
                    <code>hostname</code>

                </div>

            </div>

        </div>


        <!-- Secure Version -->

        <div class="col-md-6 mb-4">

            <div class="card border-success shadow">

                <div class="card-header bg-success text-white">

                    <h4 class="mb-0">
                        🟢 Secure Version
                    </h4>

                </div>

                <div class="card-body">

                    <p>
                        The secure version uses an allowlist
                        containing only approved commands.
                    </p>

                    <form asp-controller="CommandInjection"
                          asp-action="Secure"
                          method="post">

                        <div class="mb-3">

                            <label class="form-label">
                                Command
                            </label>

                            <input type="text"
                                   name="command"
                                   class="form-control"
                                   placeholder="whoami"
                                   required />

                        </div>

                        <button type="submit"
                                class="btn btn-success">

                            Execute Secure Command

                        </button>

                    </form>

                    <hr />

                    <p class="small text-muted">
                        Allowed commands:
                    </p>

                    <code>whoami</code>
                    <br />
                    <code>hostname</code>
                    <br />
                    <code>date</code>

                </div>

            </div>

        </div>

    </div>


    <div class="card shadow mt-3">

        <div class="card-body">

            <h4>What is OS Command Injection?</h4>

            <p>
                OS Command Injection occurs when an application
                passes user-controlled input to an operating system
                command without proper validation.
            </p>

            <h5>Security Impact</h5>

            <p>
                Successful exploitation may allow an attacker to
                execute unintended operating system commands with
                the privileges of the application.
            </p>

            <h5>Secure Mitigation</h5>

            <ul>

                <li>
                    Avoid executing shell commands when possible.
                </li>

                <li>
                    Use safe APIs instead of shell execution.
                </li>

                <li>
                    Use strict allowlists when commands are required.
                </li>

                <li>
                    Never concatenate unrestricted user input
                    into operating system commands.
                </li>

            </ul>

        </div>

    </div>

</div>