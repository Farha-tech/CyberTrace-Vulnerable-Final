@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container mt-5">

    <div class="text-center">

        <span class="badge">
            ADMIN AREA
        </span>

        <h1 class="mt-3">
            CyberTrace Admin Dashboard
        </h1>

        <p>
            Welcome to the administrative dashboard.
        </p>

    </div>

    <div class="row mt-5">

        <div class="col-md-4">

            <div class="card p-4">

                <h3>Users</h3>

                <p>
                    Manage system users and their roles.
                </p>

            </div>

        </div>

        <div class="col-md-4">

            <div class="card p-4">

                <h3>Vulnerabilities</h3>

                <p>
                    Review vulnerability information.
                </p>

            </div>

        </div>

        <div class="col-md-4">

            <div class="card p-4">

                <h3>Security Scans</h3>

                <p>
                    Review security scan results.
                </p>

            </div>

        </div>

    </div>

</div>