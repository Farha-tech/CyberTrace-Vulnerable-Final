@{
    ViewData["Title"] = "Dictionary Attack Secure Result";
}

<div class="container mt-5">

    <div class="card border-success shadow">

        <div class="card-header bg-success text-white">

            <h2>
                🟢 Dictionary Attack - Secure Result
            </h2>

        </div>

        <div class="card-body">

            @if (ViewBag.Success != null)
            {
                <div class="alert alert-success">

                    <h5>
                        Authentication Successful
                    </h5>

                    <p class="mb-0">
                        @ViewBag.Success
                    </p>

                </div>
            }

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger">

                    <strong>
                        Authentication Failed:
                    </strong>

                    <p class="mb-0">
                        @ViewBag.Error
                    </p>

                </div>
            }

            <div class="mb-3">

                <strong>Username:</strong>

                <code>
                    @ViewBag.Username
                </code>

            </div>

            <div class="alert alert-success">

                <h5>
                    Security Protection
                </h5>

                <p class="mb-0">

                    The secure version limits repeated authentication
                    attempts.

                    After three failed attempts, authentication is
                    temporarily blocked for 30 seconds.

                    This makes automated dictionary attacks much harder
                    to perform.

                </p>

            </div>

            <a asp-controller="DictionaryAttack"
               asp-action="Index"
               class="btn btn-secondary">

                Back to Dictionary Attack Lab

            </a>

        </div>

    </div>

</div>