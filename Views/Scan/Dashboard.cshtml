@{
    ViewData["Title"] = "Security Dashboard";
}

<div class="container mt-5">

    <div class="text-center mb-5">

        <span class="badge">
            CYBERTRACE SECURITY
        </span>

        <h1 class="mt-3">
            Security Dashboard
        </h1>

        <p>
            Overview of the security vulnerabilities analyzed by CyberTrace.
        </p>

    </div>

    <div class="row g-4">

        <div class="col-md-3">

            <div class="card p-4 text-center">

                <h2>5</h2>

                <h5>Total Findings</h5>

                <p class="text-muted">
                    Security issues analyzed
                </p>

            </div>

        </div>

        <div class="col-md-3">

            <div class="card p-4 text-center">

                <h2>4</h2>

                <h5>High Severity</h5>

                <p class="text-muted">
                    High-risk findings
                </p>

            </div>

        </div>

        <div class="col-md-3">

            <div class="card p-4 text-center">

                <h2>1</h2>

                <h5>Medium Severity</h5>

                <p class="text-muted">
                    Medium-risk findings
                </p>

            </div>

        </div>

        <div class="col-md-3">

            <div class="card p-4 text-center">

                <h2>3</h2>

                <h5>Protected</h5>

                <p class="text-muted">
                    Security controls implemented
                </p>

            </div>

        </div>

    </div>


    <div class="card p-4 mt-5">

        <h3 class="mb-4">
            Vulnerability Overview
        </h3>

        <div class="table-responsive">

            <table class="table table-bordered align-middle">

                <thead>

                    <tr>

                        <th>#</th>

                        <th>Vulnerability</th>

                        <th>Category</th>

                        <th>Severity</th>

                        <th>Status</th>

                    </tr>

                </thead>

                <tbody>

                    <tr>

                        <td>01</td>

                        <td>SQL Injection</td>

                        <td>Injection</td>

                        <td>
                            <span class="badge bg-danger">
                                High
                            </span>
                        </td>

                        <td>
                            Vulnerable Demo
                        </td>

                    </tr>

                    <tr>

                        <td>02</td>

                        <td>Cross-Site Scripting (XSS)</td>

                        <td>Injection</td>

                        <td>
                            <span class="badge bg-warning text-dark">
                                Medium
                            </span>
                        </td>

                        <td>
                            Vulnerable Demo
                        </td>

                    </tr>

                    <tr>

                        <td>03</td>

                        <td>Cross-Site Request Forgery (CSRF)</td>

                        <td>Broken Access Control</td>

                        <td>
                            <span class="badge bg-danger">
                                High
                            </span>
                        </td>

                        <td>
                            Protected
                        </td>

                    </tr>

                    <tr>

                        <td>04</td>

                        <td>IDOR</td>

                        <td>Broken Access Control</td>

                        <td>
                            <span class="badge bg-danger">
                                High
                            </span>
                        </td>

                        <td>
                            Protected
                        </td>

                    </tr>

                    <tr>

                        <td>05</td>

                        <td>Broken Admin Access Control</td>

                        <td>Broken Access Control</td>

                        <td>
                            <span class="badge bg-danger">
                                High
                            </span>
                        </td>

                        <td>
                            Protected
                        </td>

                    </tr>

                </tbody>

            </table>

        </div>

    </div>


    <div class="text-center mt-5 mb-5">

        <a asp-controller="Scan"
           asp-action="Index"
           class="btn btn-primary">

            Start New Security Scan

        </a>

    </div>

</div>