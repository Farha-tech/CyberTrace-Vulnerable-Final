@{
    ViewData["Title"] = "Information Disclosure Lab";
}

<div class="container mt-5">

    <div class="text-center mb-5">

        <h1>Information Disclosure</h1>

        <p class="text-muted">
            CyberTrace Information Disclosure Security Lab
        </p>

    </div>

    <div class="row">

        <!-- Vulnerable Version -->

        <div class="col-md-6 mb-4">

            <div class="card border-danger shadow">

                <div class="card-header bg-danger text-white">

                    <h4 class="mb-0">
                        🔴 Vulnerable Version
                    </h4>

                </div>

                <div class="card-body">

                    <p>
                        This version exposes internal application
                        and system information that should not be
                        available to normal users.
                    </p>

                    <a asp-controller="InformationDisclosure"
                       asp-action="Vulnerable"
                       target="_blank"
                       class="btn btn-danger">

                        View Exposed Information

                    </a>

                    <hr />

                    <p class="small text-muted mb-0">

                        The response may expose information such as
                        internal paths, database details, framework
                        information, and operating system details.

                    </p>

                </div>

            </div>

        </div>


        <!-- Secure Version -->

        <div class="col-md-6 mb-4">

            <div class="card border-success shadow">

                <div class="card-header bg-success text-white">

                    <h4 class="mb-0">
                        🟢 Secure Version
                    </h4>

                </div>

                <div class="card-body">

                    <p>
                        This version exposes only non-sensitive
                        application information.
                    </p>

                    <a asp-controller="InformationDisclosure"
                       asp-action="Secure"
                       target="_blank"
                       class="btn btn-success">

                        View Safe Information

                    </a>

                    <hr />

                    <p class="small text-muted mb-0">

                        Sensitive system and environment details
                        are not included in the response.

                    </p>

                </div>

            </div>

        </div>

    </div>


    <div class="card shadow mt-3">

        <div class="card-body">

            <h4>What is Information Disclosure?</h4>

            <p>
                Information Disclosure occurs when an application
                unintentionally reveals sensitive information about
                the application, server, database, or environment.
            </p>

            <h5>Examples</h5>

            <ul>

                <li>
                    Internal file paths
                </li>

                <li>
                    Database information
                </li>

                <li>
                    Operating system details
                </li>

                <li>
                    Framework and runtime information
                </li>

                <li>
                    Internal server information
                </li>

            </ul>

            <h5>Secure Mitigation</h5>

            <ul>

                <li>
                    Do not expose sensitive system information
                    to normal users.
                </li>

                <li>
                    Disable detailed error messages in production.
                </li>

                <li>
                    Return only the information required by the client.
                </li>

                <li>
                    Keep internal configuration and infrastructure
                    details on the server.
                </li>

            </ul>

        </div>

    </div>

</div>